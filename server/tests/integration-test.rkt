  (test-case "poll archive: endpoints, 409s, listing, duplicate, open guard"
    (define (poll-url verb id) (format "/api/polls/~a/~a" id verb))
    (define live-code (hash-ref (resp-json (as-user "POST" (format "/api/decks/~a/sessions" pid) #:json (hasheq 'label "archive"))) 'code))
    (define fresh (new-poll!))
    (define refused (as-user "POST" (poll-url "archive" (hash-ref fresh 'id))))
    (check-equal? (resp-status refused) 409)
    (check-equal? (hash-ref (resp-json refused) 'error) "poll_has_no_runs")
    (check-equal? (hash-ref (resp-json refused) 'message) "poll has no runs; delete it instead")
    (check-equal? (resp-status (as-user "POST" (poll-url "archive" 999999))) 404)
    (check-equal? (resp-status (as-user "POST" (poll-url "unarchive" 999999))) 404)
    (check-equal? (hash-ref (resp-json (as-user "POST" (poll-url "unarchive" (hash-ref fresh 'id)))) 'archived_at) 'null)
    (define pid-poll (hash-ref poll 'id))
    (define archived (as-user "POST" (poll-url "archive" pid-poll)))
    (check-equal? (resp-status archived) 200)
    (define stamp (hash-ref (resp-json archived) 'archived_at))
    (check-true (string? stamp))
    (check-equal? (hash-ref (resp-json (as-user "POST" (poll-url "archive" pid-poll))) 'archived_at) stamp)
    ;; still listed, with its timestamp
    (define listed (hash-ref (resp-json (as-user "GET" (format "/api/decks/~a" pid))) 'polls))
    (check-equal? (hash-ref (findf (λ (p) (= (hash-ref p 'id) pid-poll)) listed) 'archived_at) stamp)
    ;; a duplicate is active and the original is untouched
    (check-equal? (hash-ref (resp-json (as-user "POST" (format "/api/polls/~a/duplicate" pid-poll))) 'archived_at) 'null)
    (check-equal? (hash-ref (resp-json (as-user "POST" (poll-url "archive" pid-poll))) 'archived_at) stamp)
    ;; opening is refused while archived, allowed again afterwards
    (define blocked (post-moderator live-code "/poll/open" (hasheq 'poll_id pid-poll)))
    (check-equal? (resp-status blocked) 409)
    (check-equal? (hash-ref (resp-json blocked) 'error) "poll_archived")
    (check-equal? (hash-ref (resp-json (as-user "POST" (poll-url "unarchive" pid-poll))) 'archived_at) 'null)
    (check-equal? (resp-status (post-moderator live-code "/poll/open" (hasheq 'poll_id pid-poll))) 200))

