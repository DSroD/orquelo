  (test-case "resume: the newest closed run reopens with its votes; anything else is refused"
    (define rp (new-poll!))
    (define (resume id) (post-moderator codeA "/poll/resume" (hasheq 'run_id id)))
    (define (vote! pid option) (http "POST" (path codeA "/vote") #:json (hasheq 'run_id rid 'option_ids (list option)) #:cookies (list (pid-cookie pid))))
    (define rid (hash-ref (resp-json (post-moderator codeA "/poll/open" (hasheq 'poll_id (hash-ref rp 'id)))) 'run_id))
    (define ids (opt-ids rp))
    (check-equal? (hash-ref (resp-json (resume rid)) 'error) "run_not_resumable")
    (check-equal? (resp-status (vote! p1 (car ids))) 200)
    (check-equal? (resp-status (post-moderator codeA "/poll/close")) 204)
    (check-equal? (resp-status (vote! p1 (cadr ids))) 409)
    (drain next-a1) (drain next-screen) (drain next-moderator)
    (define r (resume rid))
    (check-equal? (resp-status r) 200)
    (check-equal? (hash-ref (resp-json r) 'run_id) rid)
    ;; the audience sees the poll open again with the earlier vote
    (define a (last-snapshot next-a1))
    (check-equal? (hash-ref (hash-ref a 'poll) 'run_id) rid)
    (check-equal? (hash-ref a 'my_vote) (list (car ids)))
    (check-equal? (hash-ref (overlay-of (last-snapshot next-screen)) 'open) #t)
    (check-equal? (resp-status (vote! p1 (cadr ids))) 200)
    (check-equal? (resp-status (vote! p2 (cadr ids))) 200)
    (define runs (hash-ref (last-snapshot next-moderator) 'runs))
    (check-equal? (length (filter (λ (x) (equal? (hash-ref x 'run_id) rid)) runs)) 1)
    (check-equal? (hash-ref (car runs) 'total_voters) 2)
    ;; still one run in the csv, with the changed vote
    (define lines (string-split (bytes->string/utf-8 (resp-body (as-user "GET" (adm codeA "/export.csv")))) "\r\n"))
    (check-equal? (length lines) (+ 1 2 3 2))
    ;; open: refused; unknown run: 404; not the newest: refused
    (check-equal? (hash-ref (resp-json (resume rid)) 'error) "run_not_resumable")
    (check-equal? (resp-status (resume 999999)) 404)
    (check-equal? (resp-status (post-moderator codeA "/poll/close")) 204)
    (check-equal? (resp-status (post-moderator codeA "/poll/open" (hasheq 'poll_id (hash-ref rp 'id)))) 200)
    (check-equal? (hash-ref (resp-json (resume rid)) 'error) "run_not_resumable")
    (check-equal? (resp-status (resume run-id)) 409)
    (check-equal? (resp-status (post-moderator codeA "/poll/resume" (hasheq))) 422)
    (drain next-a1) (drain next-a2) (drain next-screen) (drain next-moderator))

