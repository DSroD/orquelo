{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "strict": true, "skipLibCheck": true, "isolatedModules": true,
    "verbatimModuleSyntax": true, "resolveJsonModule": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["vite/client", "node"],
    "paths": { "$ext": ["./src/ext/index.ts"], "$core/*": ["./src/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte"]
}
