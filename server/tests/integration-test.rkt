    (check-equal? (resp-status (ask "Another" p1)) 429)
    (define qid (hash-ref question 'id))
    (check-equal? (resp-status (control "POST" "/overlay" (hasheq 'overlay (hasheq 'type "qa" 'question_id 'null)))) 204)
    (define screen-path (format "/api/screen/~a/~a/stream" qpid (hash-ref sess 'screen_code)))
    (define-values (_sc sci scn) (sse-open screen-path))
    (check-equal? (overlay-of (next-snapshot scn)) (hasheq 'type "qa" 'question 'null 'open #t))
    (check-equal? (resp-status (control "POST" "/overlay" (overlay-body "poll" 99999999))) 404)
    (check-true (query-value db-direct "SELECT qa_on_screen FROM lecture_sessions WHERE code=$1" code))
    (check-false (scn #:timeout 0.1))
    (check-equal? (resp-status (control "POST" "/overlay" (hasheq 'overlay (hasheq 'type "qa" 'question_id qid)))) 204)
    (check-equal? (hash-ref (overlay-of (next-snapshot scn)) 'question) (hasheq 'id qid 'text "Why is this pure?"))
    (check-equal? (resp-status (control "PATCH" (format "/qa/questions/~a" qid) (hasheq 'status "answered"))) 204)
    (check-equal? (hash-ref (overlay-of (next-snapshot scn)) 'question) 'null)
    (check-equal? (hash-ref (car (hash-ref (hash-ref (last-snapshot an) 'qa) 'questions)) 'status) "answered")
    (check-equal? (resp-status (control "POST" "/qa" (hasheq 'open #f))) 204)
    (check-equal? (resp-status (ask "Closed" p2)) 409)
    (check-equal? (resp-status (control "POST" "/qa" (hasheq 'open #t))) 204)
    ;; Editors may add answers, but never gain Q&A moderation or screen credentials.
    (check-equal? (resp-status (owner "PUT" "/shares/bob@example.org"
                                               (hasheq 'edit #t 'moderate #f 'copy #f 'results #f))) 200)
    (define editor-deck (resp-json (http "GET" deck-url #:cookies (list bob))))
    (define editor-session (car (hash-ref editor-deck 'sessions)))
    (check-equal? (hash-ref editor-session 'screen_code) 'null)
    (check-equal? (hash-ref editor-session 'screen_url) 'null)
    (define-values (_ed edi edn) (sse-open (session-url "/stream") #:cookies (list bob)))
    (define editor-snap (next-snapshot edn))
    (check-equal? (hash-ref editor-snap 'qa) 'null)
    (check-equal? (hash-ref editor-snap 'stage) 'null)
    (check-equal? (hash-ref editor-snap 'screen_url) 'null)
    (check-equal? (hash-ref (hash-ref editor-snap 'session) 'screen_code) 'null)
    (check-equal? (resp-status (http "POST" (session-url "/qa") #:cookies (list bob) #:json (hasheq 'open #f))) 403)
    (check-equal? (resp-status (http "GET" (session-url "/qa.csv") #:cookies (list bob))) 403)
    (define definition
      (resp-json (owner "POST" "/polls" (hasheq 'question "Which?" 'kind "multi" 'slide 'null
                                               'allow_additional_answers #t
                                               'options (list (hasheq 'label "A" 'exclusive #f)
                                                              (hasheq 'label "I do not know" 'exclusive #t))))))
    (define opened (resp-json (control "POST" "/poll/open" (hasheq 'poll_id (hash-ref definition 'id)))))
    (define rid (hash-ref opened 'run_id))
    (define original (hash-ref opened 'options))
    (define ids (map (λ (o) (hash-ref o 'id)) original))
    (define (cast ids) (http "POST" (public-url "/vote") #:cookies (list (pid-cookie p1))
                             #:json (hasheq 'run_id rid 'option_ids ids)))
    (check-equal? (resp-status (cast ids)) 422)
    (check-equal? (resp-status (cast (list (cadr ids)))) 200)
    (define added (http "POST" (session-url "/poll/options") #:cookies (list bob)
                        #:json (hasheq 'run_id rid 'label "Audience suggestion" 'exclusive #f)))
    (check-equal? (resp-status added) 201)
    (check-equal? (length (hash-ref (car (hash-ref (resp-json (owner "GET" "")) 'polls)) 'options)) 2)
    (check-equal? (resp-status (cast (list (hash-ref (resp-json added) 'id)))) 200)
    (check-equal? (resp-status (control "POST" "/poll/close")) 204)
    (check-equal? (resp-status (http "POST" (session-url "/poll/options") #:cookies (list bob)
                                    #:json (hasheq 'run_id rid 'label "Too late" 'exclusive #f))) 409)
    (define later (resp-json (control "POST" "/poll/open" (hasheq 'poll_id (hash-ref definition 'id)))))
    (check-equal? (length (hash-ref later 'options)) 2)
    (check-equal? (resp-status (control "POST" "/end")) 204)
    (define results (resp-json (control "GET" "/results")))
    (check-equal? (length (hash-ref (hash-ref results 'qa) 'questions)) 1)
    (check-equal? (length (hash-ref (car (hash-ref results 'runs)) 'options)) 3)
    (define csv (control "GET" "/qa.csv"))
    (check-equal? (resp-status csv) 200)
    (check-regexp-match #rx"question_id,question,status,created_at,updated_at" (resp-body csv))
    (check-false (regexp-match? (regexp (regexp-quote p1)) (bytes->string/utf-8 (resp-body csv))))
    (for ([in (list ai bi sci edi)]) (close-input-port in)))

  (test-case "logout clears the cookie"
    (define r (http "POST" "/auth/logout" #:cookies (list user-cookie)))
    (check-equal? (resp-status r) 204)
    (check-regexp-match #rx"orquelo_user=; Expires" (resp-header r "Set-Cookie")))

  (test-case "logout needs the Origin"
    (check-equal? (resp-status (http "POST" "/auth/logout" #:origin #f)) 403)
    (check-equal? (resp-status (http "POST" "/auth/logout" #:origin "http://evil.example")) 403))

  (disconnect db-direct)
  (disconnect db-login)
  (for ([in (list ina1 ina2 ins inad inb1 inbs)]) (close-input-port in)))
