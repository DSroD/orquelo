# Local development config of the core edition (password login). Copy to .env (gitignored) and fill in.
# Create users with: racket server/main.rkt user add EMAIL   (the password on stdin)
# In production, set them in the container environment; keep the ones marked [secret] in a secret store.

# --- Server ---
PORT=8080
# Prometheus scrape port (GET /metrics), served separately from PORT; unset = no metrics endpoint
# METRICS_PORT=9091
# Postgres connections in the pool (1..500); requests wait up to 5 s for one, then get a 503
# POOL_SIZE=20
PUBLIC_BASE_URL=http://localhost:8080
STATIC_DIR=web/dist
UPLOAD_DIR=data
# PDF storage: local (files in UPLOAD_DIR, default) or s3 (UPLOAD_DIR then only stages uploads).
# Example values below are for an S3-compatible provider. scripts/with-ephemeral-s3 starts a
# throwaway S3 server and exports these variables for the command it runs.
# STORAGE=s3
# S3_ENDPOINT=https://eu2.contabostorage.com
# S3_REGION=eu2
# S3_BUCKET=orquelo
# S3_PATH_STYLE=1
# [secret]
# S3_ACCESS_KEY_ID=
# [secret]
# S3_SECRET_ACCESS_KEY=
# Local Postgres (cluster: injected by CNPG as DATABASE_URL)
# scripts/dev creates the database when it is missing
DATABASE_URL=postgresql://orquelo:orquelo@localhost:5432/orquelo_core
# [secret] >=32 bytes, e.g. `openssl rand -base64 48`
SESSION_SECRET=
