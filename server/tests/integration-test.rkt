#lang racket/base
;; End-to-end: the core edition on a random port (password login) against Postgres (TEST_DATABASE_URL).
(require rackunit racket/list racket/string racket/file racket/port json net/http-client
         db "support.rkt" "../config.rkt" "../db/accounts.rkt" "../db/conn.rkt" "../domain.rkt" "../main.rkt" "../edition.rkt"
         "../editions/core.rkt" "../live/codes.rkt" (rename-in "http-client.rkt" [upload! upload-as!]))

;; ------------------------------------------------------------------ server
(define static-dir (make-temporary-file "orquelo-it-static~a" 'directory))
(define upload-dir (make-temporary-file "orquelo-it-up~a" 'directory))
(display-to-file "<html>spa</html>" (build-path static-dir "index.html") #:exists 'truncate)

;; (MutableHash Id Limits)
;; the limits of the users the limits cases name; everyone else gets the default
(define limits-by-user (make-hash))
(define default-limits (limits (* 5 1024 1024) (* 32 1024 1024) #f))
(define (test-limits c id) (hash-ref limits-by-user id default-limits))

;; Env Config -> Plugin
;; the core edition's routes, with the limits the tests set
(define (test-plugin env cfg)
  (plugin test-limits (plugin-routes ((edition-configure core-edition) env cfg))))

(define (try-start)
  (define port (+ 20000 (random 30000)))
  (define env (hash "DATABASE_URL" (test-db-url) "PUBLIC_BASE_URL" (format "http://127.0.0.1:~a" port)
                                 "STATIC_DIR" (path->string static-dir) "UPLOAD_DIR" (path->string upload-dir)
                                 "MIGRATIONS_DIR" (path->string migrations-dir)
                                 "SESSION_SECRET" (make-string 40 #\s) "PORT" (number->string port)
                                 "METRICS_PORT" (number->string (add1 port))))
  (define cfg (load-config env))
  (with-handlers ([exn:fail? (λ (e) (eprintf "start failed: ~a\n" (exn-message e)) #f)])
    (cons port (start-server cfg #:plugin (test-plugin env cfg)))))

(define (start-with-retry) (or (try-start) (try-start) (try-start) (error "could not start server")))

;; ------------------------------------------------------------------ client
(define user-cookie #f)
(define db-login #f) ; a connection that creates the users the tests log in as

(define (upload! title page-count pdf-bytes #:cookie [cookie user-cookie])
  (upload-as! title page-count pdf-bytes #:cookie cookie))

(define (as-user method path #:json [j #f] #:data [d #f] #:headers [h '()])
  (http method path #:json j #:data d #:cookies (list user-cookie) #:headers h))
(define (pid-cookie id) (string-append "orquelo_pid=" id))

;; String -> String
;; the session cookie of `email`, created if need be and logged in with a password
(define (login! [email "user@example.org"])
  (ensure-password-user! db-login email)
  (login-cookie! email))

(define (stage-of snap) (hash-ref snap 'stage))
(define (overlay-of snap) (hash-ref (stage-of snap) 'overlay))
(define (overlay-body type [run-id #f])
  (hasheq 'overlay (if run-id (hasheq 'type type 'run_id run-id) (hasheq 'type type))))
(define (next-snapshot next) (let ([e (next)]) (and (pair? e) (equal? (car e) "snapshot") (cdr e))))
(define (last-snapshot next) (let loop ([last #f]) (define s (next-snapshot (λ (#:timeout [t 0.4]) (next #:timeout t)))) (if s (loop s) last)))
(define (drain next) (let loop ([acc '()]) (define e (next #:timeout 0.4)) (if (pair? e) (loop (cons e acc)) (reverse acc))))

;; ------------------------------------------------------------------ tests
(module+ test
  (cond
    [(test-db-url)
     (disconnect (fresh-db!))
     (define started (start-with-retry))
     (define stop (cdr started))
     (dynamic-wind
      void
      (λ () (parameterize ([current-base (format "http://127.0.0.1:~a" (car started))]) (run-tests)))
      (λ () (stop) (delete-directory/files static-dir) (delete-directory/files upload-dir)))]
    [else (eprintf "SKIPPED integration-test: TEST_DATABASE_URL not set (use scripts/with-ephemeral-pg)\n")]))

(define (run-tests)
  (set! db-login (connect-direct (test-db-url)))
  (test-case "healthz, static fallback, unknown api"
    (check-equal? (resp-body (http "GET" "/healthz")) #"ok")
    (check-equal? (resp-body (http "GET" "/decks/3")) #"<html>spa</html>")
    (check-equal? (resp-body (http "GET" "/7/abcde23456")) #"<html>spa</html>")
    (check-equal? (resp-body (http "GET" "/login")) #"<html>spa</html>")
    (check-equal? (resp-status (http "GET" "/api/nope")) 404)
    (check-equal? (hash-ref (resp-json (http "GET" "/api/nope")) 'error) "not_found")
    (check-equal? (resp-status (http "GET" "/assets/missing.js")) 404))

  (test-case "a browser-sized Cookie header (>8 KiB: every cookie for the host) is accepted"
    (define big (string-append "other=" (make-string 20000 #\a)))
    (check-equal? (resp-status (http "GET" "/healthz" #:cookies (list big))) 200))

  (test-case "moderator endpoints need the session"
    (for ([p '("/api/decks" "/api/decks/1" "/api/sessions/abcde23456/stream" "/api/me")])
      (define r (http "GET" p))
      (check-equal? (resp-status r) 401 p)
      (check-equal? (hash-ref (resp-json r) 'error) "unauthorized"))
    (check-equal? (resp-status (http "POST" "/api/decks" #:cookies '("orquelo_user=forged"))) 401))

  (set! user-cookie (login!))
  (test-case "/api/me: the user and their membership"
    (define me (resp-json (as-user "GET" "/api/me")))
    (check-equal? (hash-ref (hash-ref me 'user) 'email) "user@example.org")
    (check-equal? (hash-ref (hash-ref me 'user) 'name) "user")
    (check-true (exact-integer? (hash-ref (hash-ref me 'user) 'id)))
    (check-equal? (hash-ref me 'membership)
                  (hasheq 'plan 'null 'status "active" 'storage_used 0
                          'storage_quota (* 32 1024 1024) 'max_upload_bytes (* 5 1024 1024))))

  (test-case "a suspended user, or one that no longer exists, is refused"
    (define cookie (login! "suspended@example.org"))
    (define db (connect-direct (test-db-url)))
    (check-equal? (resp-status (http "GET" "/api/me" #:cookies (list cookie))) 200)
    (query-exec db "UPDATE users SET status='suspended' WHERE email='suspended@example.org'")
    (define r (http "GET" "/api/decks" #:cookies (list cookie)))
    (check-equal? (resp-status r) 403)
    (check-equal? (hash-ref (resp-json r) 'error) "suspended")
    (query-exec db "UPDATE users SET status='active' WHERE email='suspended@example.org'")
    (query-exec db "DELETE FROM users WHERE email='suspended@example.org'")
    (disconnect db)
    (check-equal? (resp-status (http "GET" "/api/me" #:cookies (list cookie))) 401))

  (test-case "suspending a user ends their sessions for good: reactivating does not revive the old cookie"
    (define cookie (login! "epoch@example.org"))
    (define db (connect-direct (test-db-url)))
    (define id (query-value db "SELECT id FROM users WHERE email='epoch@example.org'"))
    (check-equal? (resp-status (http "GET" "/api/me" #:cookies (list cookie))) 200)
    (set-user-status! db id "suspended")
    (check-equal? (resp-status (http "GET" "/api/me" #:cookies (list cookie))) 401)
    (set-user-status! db id "active")
    (check-equal? (resp-status (http "GET" "/api/me" #:cookies (list cookie))) 401)
    (check-equal? (resp-status (http "GET" "/api/me" #:cookies (list (login! "epoch@example.org")))) 200)
    (check-equal? (resp-status (http "GET" "/api/me" #:cookies '("orquelo_user=1"))) 401 "a legacy id-only cookie")
    (disconnect db))

  (define (password-login email password #:origin [origin (current-base)])
    (http "POST" "/auth/password" #:json (hasheq 'email email 'password password) #:origin origin))
  (define (error-code r) (hash-ref (resp-json r) 'error))

  (test-case "password login: the session cookie, an email in any case, refusals without a hint"
    (ensure-password-user! db-login "pw@example.org")
    (define ok (password-login " PW@Example.org " test-password))
    (check-equal? (resp-status ok) 204)
    (define cookie (car (string-split (resp-header ok "Set-Cookie") ";")))
    (check-equal? (hash-ref (hash-ref (resp-json (http "GET" "/api/me" #:cookies (list cookie))) 'user) 'email) "pw@example.org")
    (define wrong (password-login "pw@example.org" "not the password"))
    (check-equal? (resp-status wrong) 401)
    (check-equal? (error-code wrong) "invalid_credentials")
    (define unknown (password-login "nobody@example.org" test-password))
    (check-equal? (resp-status unknown) 401)
    (check-equal? (resp-body unknown) (resp-body wrong))
    (check-equal? (resp-status (password-login "pw@example.org" "")) 422)
    (check-equal? (resp-status (password-login "pw@example.org" test-password #:origin #f)) 403)
    (check-equal? (resp-status (password-login "pw@example.org" test-password #:origin "http://evil.example")) 403))

  (test-case "a suspended user cannot log in, and can again once reactivated"
    (define id (ensure-password-user! db-login "frozen@example.org"))
    (set-user-status! db-login id "suspended")
    (define r (password-login "frozen@example.org" test-password))
    (check-equal? (resp-status r) 403)
    (check-equal? (error-code r) "suspended")
    (set-user-status! db-login id "active")
    (check-equal? (resp-status (password-login "frozen@example.org" test-password)) 204))

  (test-case "five failures for one email and address make the sixth attempt wait, even with the right password"
    (ensure-password-user! db-login "slow@example.org")
    (for ([i 5]) (check-equal? (resp-status (password-login "slow@example.org" "wrong password")) 401))
    (define r (password-login "slow@example.org" test-password))
    (check-equal? (resp-status r) 429)
    (check-equal? (error-code r) "throttled")
    (check-equal? (resp-header r "Retry-After") "1")
    (check-equal? (resp-status (password-login "other@example.org" "wrong password")) 401 "another email is not throttled"))

  (test-case "changing the password: wrong current 401, short new 422, then the old sessions and password stop working"
    (ensure-password-user! db-login "change@example.org")
    (define old (login! "change@example.org"))
    (define (change current new #:cookie [cookie old])
      (http "PUT" "/api/me/password" #:json (hasheq 'current current 'new new) #:cookies (list cookie)))
    (define wrong (change "not the password" "a brand new password"))
    (check-equal? (resp-status wrong) 401)
    (check-equal? (error-code wrong) "invalid_credentials")
    (define short (change test-password "short"))
    (check-equal? (resp-status short) 422)
    (check-equal? (hash-ref (resp-json short) 'field) "new")
    (check-equal? (resp-status (change test-password "a brand new password" #:cookie "orquelo_user=forged")) 401)
    (define ok (change test-password "a brand new password"))
    (check-equal? (resp-status ok) 204)
    (define fresh (car (string-split (resp-header ok "Set-Cookie") ";")))
    (check-equal? (resp-status (http "GET" "/api/me" #:cookies (list fresh))) 200)
    (check-equal? (resp-status (http "GET" "/api/me" #:cookies (list old))) 401)
    (check-equal? (resp-status (password-login "change@example.org" test-password)) 401)
    (check-equal? (resp-status (password-login "change@example.org" "a brand new password")) 204)
    (check-equal? (resp-status (http "PUT" "/api/me/password" #:json (hasheq 'current "x" 'new "y") #:cookies (list fresh) #:origin #f)) 403))

  (test-case "origin guard"
    (define r (http "POST" "/api/decks/1/archive" #:cookies (list user-cookie) #:origin "http://evil.example"))
    (check-equal? (resp-status r) 403)
    (check-equal? (hash-ref (resp-json r) 'error) "bad_origin")
    (check-equal? (resp-status (http "POST" "/api/decks/1/archive" #:cookies (list user-cookie) #:origin #f)) 403))

  (test-case "negative ids are 404, not a contract failure"
    (check-equal? (resp-status (as-user "GET" "/api/decks/-1")) 404)
    (check-equal? (resp-status (as-user "POST" "/api/polls/-1/duplicate")) 404)
    (check-equal? (resp-status (http "GET" "/api/s/-1/abcde23456")) 404)
    (check-equal? (resp-status (http "GET" "/api/screen/-1/abcde23456")) 404))

  (define pdf2mb (bytes-append #"%PDF-1.4\n" (make-bytes (* 2 1024 1024) 65)))

  (test-case "upload validation"
    (check-equal? (resp-status (upload! "T" "10" #"not a pdf")) 422)
    (check-equal? (hash-ref (resp-json (upload! "T" "x" pdf2mb)) 'field) "page_count")
    (check-equal? (hash-ref (resp-json (upload! "" "3" pdf2mb)) 'field) "title")
    (check-equal? (directory-list upload-dir) '()))

  (define pres (let ([r (upload! "Intro" "10" pdf2mb)])
                 (check-equal? (resp-status r) 201)
                 (resp-json r)))
  (define pid (hash-ref pres 'id))
  (test-case "2 MB upload stored and downloadable"
    (check-equal? (length (directory-list upload-dir)) 1)
    (check-equal? (hash-ref pres 'archived_at) 'null)
    (define r (as-user "GET" (format "/api/decks/~a/pdf" pid)))
    (check-equal? (resp-status r) 200)
    (check-equal? (resp-header r "Content-Type") "application/pdf")
    (check-equal? (bytes-length (resp-body r)) (bytes-length pdf2mb)))

  (define (option-inputs labels) (for/list ([label labels]) (hasheq 'label label 'exclusive #f)))
  (define (new-poll! #:slide [slide 3] #:kind [kind "single"] #:options [opts '("a" "b" "c")])
    (define r (as-user "POST" (format "/api/decks/~a/polls" pid)
                     #:json (hasheq 'slide slide 'question "Q?" 'kind kind 'options (option-inputs opts))))
    (check-equal? (resp-status r) 201)
    (resp-json r))

  (test-case "poll validation"
    (define (post j) (as-user "POST" (format "/api/decks/~a/polls" pid) #:json j))
    (check-equal? (hash-ref (resp-json (post (hasheq 'slide 99 'question "Q" 'kind "single" 'options (option-inputs '("a" "b"))))) 'field) "slide")
    (check-equal? (hash-ref (resp-json (post (hasheq 'slide 1 'question "Q" 'kind "single" 'options (option-inputs '("a"))))) 'field) "options")
    (check-equal? (resp-status (as-user "POST" (format "/api/decks/~a/polls" pid) #:data #"{nope")) 400))

  (define poll (new-poll! #:kind "single"))
  (define multi (new-poll! #:kind "multi" #:slide 'null #:options '("w" "x" "y" "z")))
  (define run-options (make-hasheqv))
  (define (opt-ids p) (map (λ (o) (hash-ref o 'id)) (hash-ref run-options (hash-ref p 'id) (λ () (hash-ref p 'options)))))

  (define (new-session! label)
    (define r (as-user "POST" (format "/api/decks/~a/sessions" pid) #:json (hasheq 'label label)))
    (check-equal? (resp-status r) 201)
    (resp-json r))
  (define A (new-session! "Class A"))
  (define B (new-session! "Class B"))
  (define codeA (hash-ref A 'code))
  (define codeB (hash-ref B 'code))
  (define scrA (hash-ref A 'screen_code))
  (define scrB (hash-ref B 'screen_code))
  (check-true (valid-code? codeA))
  (check-true (valid-code? scrA))
  (check-not-equal? scrA codeA)
  (check-not-equal? scrA scrB)
  (check-equal? (hash-ref A 'audience_url) (format "~a/~a/~a" (current-base) pid codeA))
  (check-equal? (hash-ref A 'screen_url) (format "~a/screen/~a/~a" (current-base) pid scrA))
  (define (path code suffix) (format "/api/s/~a/~a~a" pid code suffix))
  (define (spath code suffix) (format "/api/screen/~a/~a~a" pid code suffix))
  (define (adm code suffix) (format "/api/sessions/~a~a" code suffix))
  (define (post-moderator code suffix [j #f])
    (define r (as-user "POST" (adm code suffix) #:json j))
    (when (and (equal? suffix "/poll/open") (= 200 (resp-status r)))
      (hash-set! run-options (hash-ref j 'poll_id) (hash-ref (resp-json r) 'options)))
    r)

  (define p1 (random-uuid-v4))
  (define p2 (random-uuid-v4))
  (define p3 (random-uuid-v4))

  (test-case "public session info, cookie, wrong code, wrong presentation"
    (define r (http "GET" (path codeA "")))
    (check-equal? (resp-status r) 200)
    (check-equal? (resp-json r) (hasheq 'presentation (hasheq 'id pid 'title "Intro" 'page_count 10)
                                        'session (hasheq 'code codeA 'label "Class A")))
    (define c (resp-header r "Set-Cookie"))
    (check-regexp-match #px"^orquelo_pid=[0-9a-f-]{36}; Max-Age=31536000; Path=/; HttpOnly; SameSite=Lax" c)
    (check-equal? (resp-headers-all (http "GET" (path codeA "") #:cookies (list (pid-cookie p1))) "Set-Cookie") '())
    (check-equal? (resp-status (http "GET" (path "zzzzzzzzzz" ""))) 404)
    (check-equal? (resp-status (http "GET" (path "bad" ""))) 404)
    (check-equal? (resp-status (http "GET" (format "/api/s/~a/~a" (+ pid 1) codeA))) 404)
    (check-equal? (resp-status (http "GET" (path codeA "/stream?role=moderator"))) 400)
    (check-equal? (resp-status (http "GET" (path codeA "/stream"))) 400))

  (test-case "slides.pdf requires the screen code"
    (define r (http "GET" (spath scrA "/slides.pdf")))
    (check-equal? (resp-status r) 200)
    (check-equal? (resp-header r "Cache-Control") "private, max-age=3600")
    (check-equal? (bytes-length (resp-body r)) (bytes-length pdf2mb))
    (check-equal? (resp-status (http "GET" (spath "zzzzzzzzzz" "/slides.pdf"))) 404)
    ;; the audience code gets no PDF, on either path
    (check-equal? (resp-status (http "GET" (spath codeA "/slides.pdf"))) 404)
    (check-equal? (resp-status (http "GET" (path codeA "/slides.pdf"))) 404)
    (check-equal? (resp-status (http "GET" (path scrA "/slides.pdf"))) 404))

  (test-case "the audience code opens no screen, the screen code is no audience code"
    (check-equal? (resp-status (http "GET" (path codeA "/stream?role=screen"))) 400)
    (check-equal? (resp-status (http "GET" (spath codeA "/stream"))) 404)
    (check-equal? (resp-status (http "GET" (spath codeA ""))) 404)
    (check-equal? (resp-status (http "GET" (spath scrA ""))) 200)
    (check-equal? (resp-status (http "GET" (path scrA ""))) 404)
    (check-equal? (resp-status (http "GET" (path scrA "/stream?role=audience"))) 404)
    (check-equal? (resp-status (http "GET" (path scrA "/stream?role=screen"))) 404)
    (check-equal? (resp-status (http "POST" (path scrA "/vote") #:json (hasheq 'run_id 1 'option_ids '(1)))) 404)
    ;; wrong presentation id with a right screen code
    (check-equal? (resp-status (http "GET" (format "/api/screen/~a/~a" (+ pid 1) scrA))) 404)
    (check-equal? (resp-status (http "GET" (format "/api/screen/-1/~a" scrA))) 404))

  ;; streams: A audience x2, A screen, A moderator, B audience, B screen
  (define-values (sa1 ina1 next-a1) (sse-open (path codeA "/stream?role=audience") #:cookies (list (pid-cookie p1))))
  (define-values (sa2 ina2 next-a2) (sse-open (path codeA "/stream?role=audience") #:cookies (list (pid-cookie p2))))
  (define-values (ss ins next-screen) (sse-open (spath scrA "/stream")))
  (define-values (sad inad next-moderator) (sse-open (adm codeA "/stream") #:cookies (list user-cookie)))
  (define-values (sb1 inb1 next-b1) (sse-open (path codeB "/stream?role=audience") #:cookies (list (pid-cookie p1))))
  (define-values (sbs inbs next-bscreen) (sse-open (spath scrB "/stream")))

  (test-case "streams: headers and initial snapshots"
    (check-equal? sa1 #"HTTP/1.1 200 OK")
    (define s (next-snapshot next-a1))
    (check-equal? (hash-ref s 'poll) 'null)
    (check-equal? (hash-ref (hash-ref s 'session) 'code) codeA)
    (define scr0 (next-snapshot next-screen))
    (check-equal? (overlay-of scr0) 'null)
    (check-equal? (hash-ref scr0 'join_url) (hash-ref A 'audience_url))
    ;; the screen code reaches the moderator only
    (check-false (regexp-match? (regexp-quote scrA) (jsexpr->string s)))
    (check-false (regexp-match? (regexp-quote scrA) (jsexpr->string scr0)))
    (check-true (hash? (next-snapshot next-a2)))
    (check-equal? (hash-ref (hash-ref (next-snapshot next-b1) 'session) 'code) codeB)
    (check-true (hash? (next-snapshot next-bscreen)))
    ;; moderator sees connections (last snapshot wins)
    (define moderator-snaps (let loop ([last #f]) (define s (next-snapshot (λ (#:timeout [t 0.4]) (next-moderator #:timeout t)))) (if s (loop s) last)))
    (check-equal? (hash-ref moderator-snaps 'connections) (hasheq 'audience 2 'screen 1))
    (check-equal? (hash-ref (hash-ref moderator-snaps 'session) 'screen_code) scrA)
    (check-equal? (hash-ref moderator-snaps 'screen_url) (hash-ref A 'screen_url)))

  (test-case "moderator session controls: slide, qr overlay"
    (check-equal? (resp-status (post-moderator codeA "/slide" (hasheq 'slide 4))) 204)
    (check-equal? (resp-status (post-moderator codeA "/slide" (hasheq 'slide 11))) 422)
    (check-equal? (resp-status (post-moderator codeA "/overlay" (overlay-body "qr"))) 204)
    (check-equal? (hash-ref (resp-json (post-moderator codeA "/overlay" (overlay-body "bogus"))) 'field) "overlay")
    (check-equal? (hash-ref (resp-json (post-moderator codeA "/overlay" (overlay-body "poll"))) 'field) "run_id")
    (check-equal? (hash-ref (resp-json (post-moderator codeA "/overlay" (hasheq 'overlay "qr"))) 'field) "overlay")
    (check-equal? (hash-ref (resp-json (post-moderator codeA "/overlay" (hasheq))) 'field) "overlay")
    (define s (last-snapshot next-screen))
    (check-equal? (hash-ref (stage-of s) 'slide) 4)
    (check-equal? (overlay-of s) (hasheq 'type "qr"))
    (check-equal? (stage-of (last-snapshot next-moderator)) (hasheq 'slide 4 'overlay (hasheq 'type "qr")))
    (check-equal? (resp-status (post-moderator codeA "/overlay" (hasheq 'overlay 'null))) 204)
 (check-equal? (overlay-of (last-snapshot next-screen)) 'null)
    (check-equal? (resp-status (post-moderator codeA "/qr" (hasheq 'visible #t))) 404)
    (drain next-screen) (drain next-moderator))

  (test-case "poll state errors before anything is open"
    (check-equal? (hash-ref (resp-json (post-moderator codeA "/poll/close")) 'error) "poll_not_open")
    (check-equal? (hash-ref (resp-json (post-moderator codeA "/poll/reveal")) 'error) "no_poll_overlay")
    (check-equal? (hash-ref (resp-json (post-moderator codeA "/poll/hide")) 'error) "no_poll_overlay")
    (check-equal? (hash-ref (resp-json (post-moderator codeA "/overlay" (overlay-body "poll" 1))) 'error) "not_found"))

  (drain next-a1) (drain next-a2)

  (define run-id
    (let ([r (post-moderator codeA "/poll/open" (hasheq 'poll_id (hash-ref poll 'id)))])
      (check-equal? (resp-status r) 200)
      (hash-ref (resp-json r) 'run_id)))

  (test-case "open poll: audience of A sees it, session B never does"
    (define s1 (next-snapshot next-a1))
    (check-equal? (hash-ref (hash-ref s1 'poll) 'run_id) run-id)
    (check-true (hash-ref (hash-ref s1 'poll) 'open))
