#lang racket/base
;; The behaviour every `oauth-store` must have. `store-suite` returns a rackunit suite over stores
;; made by the given factory (a fresh, empty store per call), so the memory store and the Postgres
;; store are held to the same cases. The cases pin the semantics a database must reproduce:
;; values come back equal to what went in, single-use credentials survive races, and `atomically`
;; undoes everything when its thunk raises. Times are whole epoch seconds.
(require racket/contract/base rackunit "data.rkt" "store.rkt")
(provide (contract-out [store-suite (-> (-> oauth-store?) test-suite?)]))

(define resource "https://orq.example/mcp")

(define (h s) (sha256-bytes (string->bytes/utf-8 s)))
(define (a-client id #:created [created 0] #:expires [expires #f] #:kind [kind 'registered])
  (client id kind "App" #f #f '("https://app.example/cb") #f created expires))
(define (a-pending id [expires 100] [client-id "c1"])
  (pending (h id) client-id "https://app.example/cb" #t '("decks") "st" "chal" resource expires))
(define (a-code id gid [expires 60])
  (code-record (h id) gid "https://app.example/cb" #t "chal" resource '("decks") expires))
(define (a-token id gid kind [expires 1000])
  (token-record (h id) gid kind '("decks") resource expires))

;; OAuthStore -> Grant
(define (a-grant st [subject 7] [client-id "c1"] [now 0])
  (store-client-put! st (a-client client-id))
  (store-grant-create! st subject client-id '("decks" "results") 3 now))

;; OAuthStore String -> Void
;; a code, an access token and a refresh token of the grant
(define (put-all! st gid)
  (store-code-put! st (a-code "code" gid))
  (check-true (store-token-put! st (a-token "at" gid 'access)))
  (check-true (store-token-put! st (a-token "rt" gid 'refresh))))

;; Natural (-> Any) -> (listof Any)
;; the results of `n` threads started together running `thunk`
(define (race n thunk)
  (define go (make-semaphore 0))
  (define results (make-channel))
  (for ([_ (in-range n)])
    (thread (λ () (semaphore-wait go) (channel-put results (thunk)))))
  (for ([_ (in-range n)]) (semaphore-post go))
  (for/list ([_ (in-range n)]) (sync results)))

;; (-> OAuthStore) -> TestSuite
(define (store-suite make-store)
  (define-syntax-rule (store-case name (st) body ...)
    (test-case name (let ([st (make-store)]) body ...)))
  (test-suite
   "oauth store"

   (store-case "clients round-trip exactly and are replaced by id" (st)
     (check-false (store-client-ref st "c1"))
     (define full (client "https://app.example/c.json" 'metadata-document "Name" "https://app.example"
                          "https://app.example/logo.png" '("https://app.example/b" "https://app.example/a")
                          #t 10 500))
     (define bare (client "plain" 'registered "N" #f #f '("http://127.0.0.1/cb") #f 11 #f))
     (store-client-put! st full)
     (store-client-put! st bare)
     (check-equal? (store-client-ref st (client-id full)) full)
     (check-equal? (store-client-ref st "plain") bare)
     (define renamed (struct-copy client full [name "Renamed"] [expires 900]))
     (store-client-put! st renamed)
     (check-equal? (store-client-ref st (client-id full)) renamed))

   (store-case "pending requests round-trip, expire and are taken once" (st)
     (define p (a-pending "p1"))
     (define bare (struct-copy pending (a-pending "p3") [state #f] [explicit-redirect? #f]))
     (store-pending-put! st p)
     (store-pending-put! st bare)
     (check-equal? (store-pending-ref st (h "p1") 99) p)
     (check-equal? (store-pending-ref st (h "p3") 99) bare)
     (check-false (store-pending-ref st (h "p1") 100))
     (check-equal? (store-pending-take! st (h "p1") 50) p)
     (check-false (store-pending-take! st (h "p1") 50))
     (store-pending-put! st (a-pending "p2"))
     (check-false (store-pending-take! st (h "p2") 100))
     (check-false (store-pending-ref st (h "p2") 0)))

   (store-case "every approval is its own grant" (st)
     (define g1 (a-grant st))
     (define g2 (store-grant-create! st 7 "c1" '("decks") 4 10))
     (check-not-equal? (grant-id g1) (grant-id g2))
     (check-equal? (store-grant-ref st (grant-id g1)) g1)
     (check-equal? (store-grant-ref st (grant-id g2))
                   (grant (grant-id g2) 7 "c1" '("decks") 4 10 #f))
     (check-equal? (length (store-grants-of st 7)) 2)
     (check-equal? (store-grants-of st 8) '())
     (check-false (store-grant-ref st "nope")))

   (store-case "grant-touch! records the time and keeps the rest" (st)
     (define g (a-grant st 7 "c1" 5))
     (store-grant-touch! st (grant-id g) 42)
     (check-equal? (store-grant-ref st (grant-id g)) (struct-copy grant g [last-used 42]))
     (store-grant-touch! st "nope" 1))

   (store-case "grant-delete! needs the owner, cascades, and spares other grants" (st)
     (define g (a-grant st))
     (define other (store-grant-create! st 7 "c1" '("decks") 3 0))
     (put-all! st (grant-id g))
     (store-token-put! st (a-token "otherat" (grant-id other) 'access))
     (check-false (store-grant-delete! st 8 (grant-id g)))
     (check-true (pair? (store-access-ref st (h "at") 1)))
     (check-true (store-grant-delete! st 7 (grant-id g)))
     (check-false (store-grant-delete! st 7 (grant-id g)))
     (check-false (store-grant-ref st (grant-id g)))
     (check-false (store-access-ref st (h "at") 1))
     (check-false (store-refresh-ref st (h "rt") 1))
     (check-false (store-code-consume! st (h "code") 1))
     (check-true (pair? (store-access-ref st (h "otherat") 1)))
     (check-equal? (map grant-id (store-grants-of st 7)) (list (grant-id other))))

   (store-case "authorization codes round-trip, work once, then report reuse" (st)
     (define g (a-grant st))
     (define c (a-code "code" (grant-id g)))
     (store-code-put! st c)
     (check-equal? (store-code-consume! st (h "code") 10) c)
     (check-equal? (store-code-consume! st (h "code") 11) (reused (grant-id g)))
     (check-equal? (store-code-consume! st (h "code") 1000) (reused (grant-id g)))
     (check-false (store-code-consume! st (h "unknown") 10)))

   (store-case "an expired authorization code is refused" (st)
     (define g (a-grant st))
     (store-code-put! st (a-code "code" (grant-id g) 60))
     (check-false (store-code-consume! st (h "code") 60)))

   (store-case "access tokens round-trip with their grant and expire" (st)
     (define g (a-grant st))
     (define t (a-token "at" (grant-id g) 'access 100))
     (check-true (store-token-put! st t))
     (check-equal? (store-access-ref st (h "at") 99) (cons t g))
     (check-false (store-access-ref st (h "at") 100))
     (check-false (store-access-ref st (h "nope") 1))
     (check-false (store-access-ref st (h "rt") 1) "a refresh token is not an access token"))

   (store-case "a token for a missing grant is not stored" (st)
     (check-false (store-token-put! st (a-token "at" "gone" 'access)))
     (check-false (store-token-put! st (a-token "rt" "gone" 'refresh)))
     (check-false (store-access-ref st (h "at") 1))
     (check-false (store-refresh-ref st (h "rt") 1)))

   (store-case "refresh-ref and refresh-rotate! retire the old token and store the new ones" (st)
     (define g (a-grant st))
     (define old (a-token "rt1" (grant-id g) 'refresh 500))
     (store-token-put! st old)
     (check-equal? (store-refresh-ref st (h "rt1") 10) (cons old g))
     (define new (list (a-token "rt2" (grant-id g) 'refresh 900) (a-token "at2" (grant-id g) 'access 100)))
     (check-equal? (store-refresh-rotate! st (h "rt1") 10 (grant-id g) new)
                   (struct-copy grant g [last-used 10]))
     (check-equal? (store-grant-ref st (grant-id g)) (struct-copy grant g [last-used 10]))
     (check-true (pair? (store-access-ref st (h "at2") 11)))
     (check-equal? (store-refresh-ref st (h "rt1") 11) (reused (grant-id g)))
     (check-equal? (store-refresh-rotate! st (h "rt1") 11 (grant-id g) '()) (reused (grant-id g)))
     (check-equal? (store-refresh-rotate! st (h "rt1") 600 (grant-id g) '()) (reused (grant-id g)))
     (check-true (pair? (store-refresh-ref st (h "rt2") 12))))

   (store-case "refresh-rotate! refuses expired, unknown and foreign tokens and changes nothing" (st)
     (define g (a-grant st))
     (define other (store-grant-create! st 7 "c1" '("decks") 3 0))
     (store-token-put! st (a-token "rt" (grant-id g) 'refresh 500))
     (define new (list (a-token "new" (grant-id g) 'access 900)))
     (check-false (store-refresh-ref st (h "rt") 500))
     (check-false (store-refresh-rotate! st (h "rt") 500 (grant-id g) new))
     (check-false (store-refresh-rotate! st (h "unknown") 1 (grant-id g) new))
     (check-false (store-refresh-rotate! st (h "rt") 1 (grant-id other) new) "expected grant differs")
     (check-false (store-access-ref st (h "new") 1))
     (check-true (grant? (store-refresh-rotate! st (h "rt") 2 (grant-id g) new))
                 "a refused rotation leaves the token usable"))

   (store-case "atomically returns the thunk's value and nests with operations" (st)
     (define g (a-grant st))
     (check-equal? (store-atomically st (λ () (store-grant-touch! st (grant-id g) 9) 'done)) 'done)
     (check-equal? (grant-last-used (store-grant-ref st (grant-id g))) 9))

   (store-case "atomically undoes everything when its thunk raises" (st)
     (define keep (a-grant st))
     (store-code-put! st (a-code "code" (grant-id keep)))
     (store-token-put! st (a-token "rt" (grant-id keep) 'refresh))
     (store-pending-put! st (a-pending "p"))
     (define made #f)
     (check-exn
      exn:fail?
      (λ ()
        (store-atomically
         st
         (λ ()
           (set! made (store-grant-create! st 8 "c1" '("decks") 1 0))
           (store-token-put! st (a-token "at" (grant-id made) 'access))
           (store-code-consume! st (h "code") 5)
           (store-pending-take! st (h "p") 5)
           (store-refresh-rotate! st (h "rt") 5 (grant-id keep) '())
           (store-grant-delete! st 7 (grant-id keep))
           (error "boom")))))
     (check-false (store-grant-ref st (grant-id made)))
     (check-false (store-access-ref st (h "at") 1))
     (check-true (grant? (store-grant-ref st (grant-id keep))))
     (check-true (code-record? (store-code-consume! st (h "code") 5)) "the code was not spent")
     (check-true (pending? (store-pending-take! st (h "p") 5)))
     (check-true (pair? (store-refresh-ref st (h "rt") 5)) "the token was not retired")
     (check-false (grant-last-used (store-grant-ref st (grant-id keep))))
     ;; and the store still works afterwards, from another thread too
     (thread-wait (thread (λ () (store-grant-touch! st (grant-id keep) 1))))
     (check-equal? (grant-last-used (store-grant-ref st (grant-id keep))) 1))

   (store-case "atomically also undoes everything for a non-exn raise and for an escape" (st)
     (define keep (a-grant st))
     (define (mutate!)
       (store-grant-create! st 8 "c1" '("decks") 1 0)
       (store-token-put! st (a-token "at" (grant-id keep) 'access))
       (store-grant-touch! st (grant-id keep) 9))
     (define (unchanged?)
       (check-equal? (store-grants-of st 8) '())
       (check-false (store-access-ref st (h "at") 1))
       (check-false (grant-last-used (store-grant-ref st (grant-id keep)))))
     (check-equal? (with-handlers ([symbol? values]) (store-atomically st (λ () (mutate!) (raise 'boom)))) 'boom)
     (unchanged?)
     (check-equal? (let/ec k (store-atomically st (λ () (mutate!) (k 'escaped)))) 'escaped)
     (unchanged?)
     (store-grant-touch! st (grant-id keep) 1)
     (check-equal? (grant-last-used (store-grant-ref st (grant-id keep))) 1))

   (store-case "a failed nested atomically undoes only its own operations" (st)
     (define g (a-grant st))
     (store-atomically
      st
      (λ ()
        (store-grant-touch! st (grant-id g) 1)
        (check-exn exn:fail?
                   (λ () (store-atomically st (λ () (store-grant-touch! st (grant-id g) 2) (error "inner")))))))
     (check-equal? (grant-last-used (store-grant-ref st (grant-id g))) 1))

   (store-case "racing consumers of one code: exactly one wins, the rest see reuse" (st)
     (define g (a-grant st))
     (store-code-put! st (a-code "code" (grant-id g)))
     (define results (race 12 (λ () (store-code-consume! st (h "code") 5))))
     (check-equal? (length (filter code-record? results)) 1)
     (check-equal? (length (filter (λ (r) (equal? r (reused (grant-id g)))) results)) 11))

   (store-case "racing rotations of one refresh token: exactly one wins, the rest see reuse" (st)
     (define g (a-grant st))
     (store-token-put! st (a-token "rt" (grant-id g) 'refresh 500))
     (define results
       (race 12 (λ () (store-refresh-rotate! st (h "rt") 5 (grant-id g) '()))))
     (check-equal? (length (filter grant? results)) 1)
     (check-equal? (length (filter (λ (r) (equal? r (reused (grant-id g)))) results)) 11))

   (store-case "sweep! removes only what has expired" (st)
     (define g (a-grant st))
     (store-pending-put! st (a-pending "old" 50))
     (store-pending-put! st (a-pending "new" 500))
     (store-code-put! st (a-code "oldcode" (grant-id g) 50))
     (store-code-put! st (a-code "newcode" (grant-id g) 500))
     (store-token-put! st (a-token "oldat" (grant-id g) 'access 50))
     (store-token-put! st (a-token "newat" (grant-id g) 'access 500))
     (store-token-put! st (a-token "oldrt" (grant-id g) 'refresh 50))
     (store-token-put! st (a-token "newrt" (grant-id g) 'refresh 500))
     (store-sweep! st 100)
     (check-false (store-pending-ref st (h "old") 0))
     (check-true (pending? (store-pending-ref st (h "new") 0)))
     (check-false (store-code-consume! st (h "oldcode") 0))
     (check-true (code-record? (store-code-consume! st (h "newcode") 0)))
     (check-false (store-access-ref st (h "oldat") 0))
     (check-true (pair? (store-access-ref st (h "newat") 0)))
     (check-false (store-refresh-ref st (h "oldrt") 0))
     (check-true (pair? (store-refresh-ref st (h "newrt") 0)))
     (check-true (grant? (store-grant-ref st (grant-id g)))))

   (store-case "sweep! deletes old grants that hold no token" (st)
     (define bare-old (a-grant st 7 "c1" 0))
     (define bare-new (store-grant-create! st 7 "c1" '("decks") 3 1000))
     (define with-access (store-grant-create! st 7 "c1" '("decks") 3 0))
     (define with-refresh (store-grant-create! st 7 "c1" '("decks") 3 0))
     (store-token-put! st (a-token "at" (grant-id with-access) 'access 5000))
     (store-token-put! st (a-token "rt" (grant-id with-refresh) 'refresh 5000))
     (store-code-put! st (a-code "code" (grant-id bare-old) 5000))
     (store-sweep! st 1000)
     (check-false (store-grant-ref st (grant-id bare-old)))
     (check-false (store-code-consume! st (h "code") 1))
     (check-true (grant? (store-grant-ref st (grant-id bare-new))))
     (check-true (grant? (store-grant-ref st (grant-id with-access))))
     (check-true (grant? (store-grant-ref st (grant-id with-refresh))))
     (store-sweep! st 1900)
     (check-false (store-grant-ref st (grant-id bare-new)))
     (check-equal? (length (store-grants-of st 7)) 2))

   (store-case "sweep! keeps clients that something refers to" (st)
     (define day (* 24 60 60))
     (define now (* 100 day))
     (store-client-put! st (a-client "stale" #:expires 50 #:kind 'metadata-document))
     (store-client-put! st (a-client "fresh" #:expires (+ now 1000) #:kind 'metadata-document))
     (store-client-put! st (a-client "reg-old" #:created 0))
     (store-client-put! st (a-client "reg-29d" #:created (- now (* 29 day))))
     (store-client-put! st (a-client "reg-new" #:created (- now 10)))
     (store-client-put! st (a-client "stale-with-grant" #:expires 50 #:kind 'metadata-document))
     (store-client-put! st (a-client "stale-with-pending" #:expires 50 #:kind 'metadata-document))
     (store-client-put! st (a-client "reg-old-with-grant" #:created 0))
     (for ([cid '("stale-with-grant" "reg-old-with-grant")])
       (define g (store-grant-create! st 7 cid '("decks") 3 0))
       (store-token-put! st (a-token (string-append "rt-" cid) (grant-id g) 'refresh (+ now 1000))))
     (store-pending-put! st (a-pending "p" (+ now 1000) "stale-with-pending"))
     (store-sweep! st now)
     (check-false (store-client-ref st "stale"))
     (check-false (store-client-ref st "reg-old"))
     (for ([id '("fresh" "reg-29d" "reg-new" "stale-with-grant" "stale-with-pending" "reg-old-with-grant")])
       (check-true (client? (store-client-ref st id)) id)))))

(module+ test
  (require rackunit/text-ui)
  (check-equal? (run-tests (store-suite make-memory-store) 'normal) 0))
